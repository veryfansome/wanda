# Copy to .env and fill in. wanda's own settings are prefixed WANDA_. The
# container is given only what compose.wanda.yaml names: the Docker section
# and the clock's below, the two Slack tokens, WANDA_SLACK_OWNER_USER_IDS and
# WANDA_SLACK_NAMES. The rest is read on the Mac alone, by what runs there.

# --- Docker (compose.wanda.yaml) ---
# A long-lived token for the claude CLI in the container: `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
# The household's time zone: the date and time every session is told, and when
# its day turns over. Required.
WANDA_TZ=America/Los_Angeles
# Where failures nobody would otherwise see are posted (a startup check that
# fails, a snapshot that fails, an answer that could not be posted, and the
# clock's, listed below): a private channel's id, or fan's user id for his DM
# with wanda; either way no session is shown them. Required with triage off;
# with it on, empty means the triage channel. Until a test alert in fan's DM
# has been seen to stay out of his next session there, a private channel of
# fan's and wanda's, where nobody mentions her, is recommended: alerts are kept
# from sessions by a mark Slack has to hand back, and in his DM an alert whose
# mark did not come back would reach his sessions as her own earlier words.
WANDA_ALERT_CHANNEL=
# How many memory sessions run at once, 1 or 2; unset or empty, the default in
# wanda/config.py. compose.wanda.yaml passes it only when it is set here.
# WANDA_MEMORY_SESSIONS=2

# --- the clock (compose.wanda.yaml passes both in) ---
# Whose morning gets a look from wanda, and when, in WANDA_TZ:
# <member id>@HH:MM, before noon, each id one of WANDA_SLACK_OWNER_USER_IDS.
# Empty = no morning looks.
# Reminders asked for at a time of day need no setting. The clock's failures go
# to WANDA_ALERT_CHANNEL too: a look or a reminder that could not start or
# failed, and each timed reminder not given at its time, by its id and time.
# WANDA_MORNINGS=U0123456789@08:00,U0987654321@08:00
# No morning look starts in these hours; a reminder asked for at a time in them
# still comes then. Unset: 21:30-07:00. Empty = no quiet hours.
# WANDA_QUIET_HOURS=21:30-07:00

# --- Email triage ---
# off: no iCloud settings needed, and no mail is read. compose.wanda.yaml sets it off.
# WANDA_EMAIL_TRIAGE=on

# --- iCloud IMAP ---
# App-specific password: https://appleid.apple.com -> Sign-In and Security -> App-Specific Passwords
WANDA_ICLOUD_EMAIL=you@icloud.com
WANDA_ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Slack (create app from slack/manifest.yaml, install to workspace) ---
# Bot token: OAuth & Permissions page (xoxb-...)
WANDA_SLACK_BOT_TOKEN=xoxb-...
# App-level token with connections:write scope: Basic Information -> App-Level Tokens (xapp-...)
WANDA_SLACK_APP_TOKEN=xapp-...
# Channel wanda posts email triage to (invite the bot to it), e.g. C0123456789
WANDA_EMAIL_TRIAGE_SLACK_CHANNEL_ID=
# Who may talk to wanda: member IDs (profile -> ... -> Copy member ID), e.g.
# U0123456789 — note those start with U; a D... id is a DM channel and will
# never match. Required: every session reads the household's whole memory and
# has a shell (README, Trust assumption).
WANDA_SLACK_OWNER_USER_IDS=
# The name each of them has in wanda's memory, id:name, e.g. U0123456789:fan;
# each name once, and only for an id listed above: the clock opens a direct
# message by name, and the daemon refuses to start otherwise
WANDA_SLACK_NAMES=
# Only needed for `wanda slack search` (user token, xoxp-, with search:read)
WANDA_SLACK_USER_TOKEN=
# How many messages a memory session's context is read from: in a thread, its
# first and its newest replies, this many in all; elsewhere the newest this
# many, of which a session is shown the last 12 hours, at most 20. Not passed
# by compose.wanda.yaml.
# WANDA_SLACK_CONTEXT_LIMIT=50

# --- Enforcement ---
# shadow: log "WOULD trash" to the digest, never touch the mailbox. live: actually move to Trash.
WANDA_ENFORCEMENT=shadow
# Comma-separated addresses or domains that must never be trashed
WANDA_NEVER_TRASH=icloud.com,apple.com

# --- claude CLI ---
# For what runs on the Mac, when `claude` is not on its PATH (`which claude`);
# the container finds its own
WANDA_CLAUDE_BIN=/Users/you/.local/bin/claude
WANDA_EMAIL_TRIAGE_MODEL=claude-haiku-4-5-20251001
WANDA_AGENT_MODEL=sonnet

# --- Optional overrides (defaults shown) ---
# WANDA_TRASH_CONFIDENCE_MIN=0.8
# WANDA_TRASH_CAP_HOURLY=5
# WANDA_TRASH_CAP_DAILY=20
# Max messages `wanda triage` will classify in one dry run
# WANDA_DRYRUN_MAX_LIMIT=200
# WANDA_DAILY_RUN_CAP=200
# WANDA_DAILY_COST_CAP_USD=5.0
# WANDA_DATA_DIR=~/.wanda
# WANDA_TRASH_FOLDER=            # override SPECIAL-USE discovery, e.g. "Deleted Messages"
# Tools agent sessions get. Bash is what lets them run `wanda slack`; read the
# security note in the README before changing this.
# WANDA_AGENT_ALLOWED_TOOLS=Bash,Read,WebSearch,Skill
# WANDA_LOG_LEVEL=INFO
