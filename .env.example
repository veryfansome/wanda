# Copy to .env and fill in. All variables are prefixed WANDA_; the ones that only
# configure the email pipeline (mailbox, triage, trash guards) are WANDA_EMAIL_.

# --- iCloud IMAP ---
# App-specific password: https://appleid.apple.com -> Sign-In and Security -> App-Specific Passwords
WANDA_EMAIL_ICLOUD_EMAIL=you@icloud.com
WANDA_EMAIL_ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Slack (create app from slack/manifest.yaml, install to workspace) ---
# Bot token: OAuth & Permissions page (xoxb-...)
WANDA_SLACK_BOT_TOKEN=xoxb-...
# App-level token with connections:write scope: Basic Information -> App-Level Tokens (xapp-...)
WANDA_SLACK_APP_TOKEN=xapp-...
# Channel wanda posts email triage to (invite the bot to it), e.g. C0123456789
WANDA_EMAIL_TRIAGE_SLACK_CHANNEL_ID=
# Who may talk to wanda. Empty = anyone in the workspace. To restrict, list
# member IDs (profile -> ... -> Copy member ID), e.g. U0123456789 — note those
# start with U; a D... id is a DM channel and will never match.
WANDA_SLACK_ALLOWED_USER_IDS=
# Whose word makes memory RULES — the people who may tell wanda what happens
# to mail (`rule priya@example.com trash` in Slack). Empty = rules disabled.
# Usually you and your partner. Member IDs, comma-separated.
WANDA_MEMORY_OWNER_USER_IDS=
# Only needed for `wanda slack search` (user token, xoxp-, with search:read)
WANDA_SLACK_USER_TOKEN=
# How many recent messages a mention/DM session is given as context
# WANDA_SLACK_CONTEXT_LIMIT=50

# --- Enforcement ---
# shadow: log "WOULD trash" to the digest, never touch the mailbox. live: actually move to Trash.
WANDA_EMAIL_ENFORCEMENT=shadow
# Comma-separated addresses or domains that must never be trashed
WANDA_EMAIL_NEVER_TRASH=icloud.com,apple.com

# --- claude CLI ---
# Absolute path matters under launchd (PATH is minimal there); `which claude`
WANDA_CLAUDE_BIN=/Users/you/.local/bin/claude
WANDA_EMAIL_TRIAGE_MODEL=claude-haiku-4-5-20251001
WANDA_AGENT_MODEL=sonnet

# --- Memory (defaults shown) ---
# The vault: an Obsidian-openable folder of markdown, git-tracked by wanda.
# WANDA_MEMORY_DIR=~/.wanda/memory
# WANDA_MEMORY_ENABLED=true
# Model for the nightly distillation pass (one call a night, plus one when your filing preferences changed; no tools)
# WANDA_MEMORY_MODEL=claude-haiku-4-5-20251001
# WANDA_MEMORY_MAX_BUDGET_USD=0.50       # per-call size ceiling, not a bill
# WANDA_MEMORY_TIMEOUT_S=180
# Hours between paid distillation passes; 24 = nightly at the local time below
# WANDA_MEMORY_DISTILL_HOURS=24
# WANDA_MEMORY_NIGHTLY_LOCAL_TIME=03:30
# Only owner-stated preferences may rewrite a filing guide (off: wanda files autonomously and reports diffs)
# WANDA_MEMORY_WRITESPEC_OWNER_ONLY=false

# --- Optional overrides (defaults shown) ---
# WANDA_EMAIL_TRASH_CONFIDENCE_MIN=0.8
# WANDA_EMAIL_TRASH_CAP_HOURLY=5
# WANDA_EMAIL_TRASH_CAP_DAILY=20
# Emails per triage run, and how long to let a batch form before triaging it
# WANDA_EMAIL_TRIAGE_BATCH_SIZE=10
# WANDA_EMAIL_TRIAGE_DEBOUNCE_S=150
# Max messages `wanda triage` will classify in one dry run
# WANDA_EMAIL_DRYRUN_MAX_LIMIT=200
# The only breaker: a run count that stops a runaway loop (wanda runs on a
# subscription, so there is no dollar cap)
# WANDA_DAILY_RUN_CAP=1000
# WANDA_DATA_DIR=~/.wanda
# WANDA_EMAIL_TRASH_FOLDER=      # override SPECIAL-USE discovery, e.g. "Deleted Messages"
# Tools agent sessions get. Bash is what lets them run `wanda slack`; read the
# security note in the README before changing this.
# WANDA_AGENT_ALLOWED_TOOLS=Bash,Read,WebSearch,Skill
# WANDA_LOG_LEVEL=INFO
